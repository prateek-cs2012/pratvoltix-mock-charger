MONGODB_URI=mongodb://localhost:27017/pratvoltix
# Host-published lab ports (avoid CSMS 8080/4200). Container-internal API still uses 8080.
PORT=18080
PUBLIC_WS_URL=ws://localhost:14200/ocpp
HEARTBEAT_INTERVAL=60
# Mock OCPP → live CSMS gateway (lab UI/API stay on 18080/14200).
CSMS_URL=ws://localhost:8080/ocpp
CONTROL_URL=ws://localhost:18080/lab-control
# External CSMS gateway (websocket-gateway). Path is /ocpp/{chargerId}.
TARGET_CSMS_URL=ws://host.docker.internal:8080/ocpp/{stationId}
CHARGE_POINT_ID=CP001
CHARGE_POINT_VENDOR=Pratvoltix
CHARGE_POINT_MODEL=Lab-One
SIMULATOR_NAME=Pratvoltix Mock
SIMULATOR_VERSION=0.1.0
